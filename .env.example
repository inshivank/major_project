# Copy to .env and fill in real values. Never commit .env.
GROQ_API_KEY=

# Optional overrides
# SDK adds /openai/v1; legacy URLs ending in that suffix are also accepted.
GROQ_BASE_URL=https://api.groq.com
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
RETRIEVAL_TOP_K=4
COLLECTION_NAME=corecare_medical

# Week 4: local document processing (external LLM consent is mandatory per request)
REPORT_UPLOAD_TIMEOUT_SECONDS=30
REPORT_MAX_UPLOAD_BYTES=10485760
REPORT_MAX_PDF_PAGES=10
REPORT_MAX_IMAGE_PIXELS=20000000
REPORT_MAX_TEXT_CHARS=100000
REPORT_OCR_TIMEOUT_SECONDS=15
REPORT_PROCESSING_TIMEOUT_SECONDS=120
REPORT_MAX_CONCURRENT=2
REPORT_WORKER_MEMORY_MB=512
# Optional absolute path to tesseract.exe if it is not on PATH
TESSERACT_CMD=
